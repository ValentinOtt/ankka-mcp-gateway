{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "ankka-read-only-connector",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-27",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  // No invocation logs or traces: MCP bodies can contain private team data.
  "observability": { "enabled": false },
  // Replace locally; never commit deployment/account/resource identifiers.
  "vars": {
    "CONNECTOR_PROVIDER": "unconfigured",
    "CONNECTOR_CONFIG_JSON": "{}",
    "PUBLIC_ORIGIN": "https://connector.example.com",
    "ACCESS_TEAM_DOMAIN": "example.cloudflareaccess.com",
    "ACCESS_AUD": "replace-in-your-private-deployment-config"
  },
  "secrets": { "required": ["PROVIDER_TOKEN"] }
}
