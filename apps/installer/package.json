{
  "name": "@ankka/gateway-installer",
  "version": "0.1.0-alpha.0",
  "private": true,
  "type": "module",
  "license": "Apache-2.0",
  "scripts": {
    "build": "npm run typecheck && npm run build:deploy && npm run build:auth",
    "build:deploy": "wrangler deploy --dry-run --outdir dist/deploy --config wrangler.toml",
    "build:auth": "wrangler deploy --dry-run --outdir dist/auth --config wrangler.auth.toml",
    "dev": "wrangler dev --config wrangler.toml",
    "dev:ui": "vite --config vite.preview.config.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "~5.20260831.1",
    "typescript": "7.0.2",
    "vitest": "~4.1.9",
    "wrangler": "~4.127.1"
  },
  "dependencies": {
    "valibot": "^1.4.2"
  }
}
