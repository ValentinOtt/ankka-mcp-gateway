{
  "name": "@ankka/gateway-installer",
  "version": "0.1.0-alpha.0",
  "private": true,
  "type": "module",
  "license": "Apache-2.0",
  "scripts": {
    "build": "npm run typecheck && wrangler deploy --dry-run --outdir dist --config wrangler.reviewed-disabled.toml",
    "dev": "wrangler dev --config wrangler.toml",
    "dev:ui": "vite --config vite.preview.config.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "~5.20260814.1",
    "typescript": "^7.0.2",
    "vitest": "~4.1.9",
    "wrangler": "~4.123.0"
  }
}
