{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ankka.ai/schemas/mcp-gateway/v1.json",
  "title": "Ankka MCP Gateway configuration",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "gateway", "policy", "sources"],
  "properties": {
    "$schema": { "type": "string" },
    "schemaVersion": { "const": 1 },
    "gateway": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "hostname", "codeMode"],
      "properties": {
        "name": { "type": "string", "minLength": 1, "maxLength": 80 },
        "hostname": { "type": "string", "minLength": 1, "maxLength": 253 },
        "codeMode": {
          "enum": ["off", "opt_in", "default_on", "enforced"]
        }
      }
    },
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["capabilityMode", "credentialCustody", "telemetry"],
      "properties": {
        "capabilityMode": { "const": "read_only" },
        "credentialCustody": { "const": "customer" },
        "telemetry": { "const": "off" }
      }
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "maxItems": 40,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "label", "url", "authentication", "enabledTools"],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]{0,31}$"
          },
          "label": { "type": "string", "minLength": 1, "maxLength": 80 },
          "url": { "type": "string", "format": "uri" },
          "authentication": {
            "type": "object",
            "additionalProperties": false,
            "required": ["mode", "onBehalfOfUser"],
            "properties": {
              "mode": { "enum": ["none", "bearer", "oauth", "headers"] },
              "onBehalfOfUser": { "type": "boolean" }
            }
          },
          "enabledTools": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128,
              "not": { "const": "*" }
            }
          }
        }
      }
    }
  }
}
